# Copia este fichero a .env: docker compose lo lee solo. (El .env nunca se versiona.)
# Linux: UID y GID de tu usuario, para que los ficheros de my-profile sean tuyos. En Docker Desktop no hacen falta.
UID=1000
GID=1000
# Para usar siempre la superposición de IA sin repetir -f:
# COMPOSE_FILE=compose.yml:compose.ai.yml
# Otro modelo (solo tras validarlo con npm run test:acceptance:ai):
# CHAMELEON_LLM_MODEL=qwen2.5:7b-instruct
